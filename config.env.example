LOG_LEVEL="INFO"
DATA_DIR="experiment data"
OUTPUT_DIR="outputs"
MODEL_PROVIDER="ollama"
MODEL_TIMEOUT="300"
MODEL_RETRIES="3"

OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_GENERATION_MODEL="qwen3.5:9b"
OLLAMA_AUXILIARY_MODEL="qwen3.5:4b"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_GENERATION_MODEL="openai/gpt-5.2"
OPENROUTER_AUXILIARY_MODEL="openai/gpt-5.2"
OPENROUTER_HTTP_REFERER=""
OPENROUTER_APP_TITLE="iRAG experiments"

# A Bedrock bearer token is sufficient for Bedrock Runtime calls. Alternatively,
# leave it empty and use BEDROCK_PROFILE or the standard AWS credential chain.
AWS_BEARER_TOKEN_BEDROCK=""
BEDROCK_REGION="eu-west-1"
BEDROCK_PROFILE=""
BEDROCK_RETRIES="10"
BEDROCK_THROTTLE_RETRIES="100"
BEDROCK_THROTTLE_MAX_DELAY="60"
BEDROCK_RESPONSE_RETRIES="10"
BEDROCK_RESPONSE_MAX_DELAY="10"
BEDROCK_DECISION_RESPONSE_RETRIES="3"
BEDROCK_GENERATION_MODEL="eu.amazon.nova-2-lite-v1:0"
BEDROCK_AUXILIARY_MODEL="eu.amazon.nova-2-lite-v1:0"

# This selects the checked-in .npz directory; embeddings are never generated at runtime.
EMBEDDING_MODEL="qwen3-embedding:4b"
